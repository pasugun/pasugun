# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 절대 커밋하지 않는다.

# --- 토스증권 Open API ---
# mock: tests/fixtures 응답 사용(기본값), live: 실제 API 호출(허용 IP 등록 필요)
TOSS_MODE=mock
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=

# --- DB ---
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal
POSTGRES_DB=signal
# 호스트에 노출할 포트(다른 Postgres와 겹치지 않게 기본 5433)
POSTGRES_PORT=5433
# 호스트에서 engine 을 직접 실행할 때 쓰는 주소. docker compose 안에서는 자동으로 db 호스트로 바뀐다.
DATABASE_URL=postgresql+psycopg://signal:signal@localhost:5433/signal

# --- 수집 배치 ---
# 평일 15:50 KST (분 시 일 월 요일)
COLLECT_CRON=50 15 * * mon-fri
# 대상 종목 최소 20일 평균 거래대금(원)
COLLECT_MIN_AVG_TRADING_VALUE=1000000000
# (선택) 상장폐지 종목 보충용 KRX 정보데이터시스템 계정. `collect backfill --include-delisted` 에서만 사용
KRX_ID=
KRX_PW=

# --- 텔레그램 ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (신호 설명) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- 웹 ---
WEB_BASIC_AUTH_USER=
WEB_BASIC_AUTH_PASS=
WEB_PORT=3001
ENGINE_API_PORT=8000
